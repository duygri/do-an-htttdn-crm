@startuml
title III-01 - Customer account registration use case

left to right direction
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}

actor Customer

rectangle "Customer Portal\nCRM and Sales" {
    usecase "UC-01\nRegister account" as UC01
    usecase "Validate registration\ndata" as Validate
    usecase "Hash password" as Hash
    usecase "Enforce unique\nemail" as UniqueEmail
}

Customer --> UC01
UC01 .> Validate : <<include>>
UC01 .> Hash : <<include>>
UC01 .> UniqueEmail : <<include>>
@enduml

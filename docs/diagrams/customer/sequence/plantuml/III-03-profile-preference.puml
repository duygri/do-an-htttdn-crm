@startuml
title III-03 - Customer profile and preference update

autonumber
hide footbox
skinparam monochrome true
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Customer
boundary "Customer Portal" as Web
control "Profile API" as API
database "CRM Database" as DB

Customer -> Web: Open profile page
Web -> API: GET /api/customers/me\nAuthorization: Bearer accessToken
API -> API: Verify JWT and customer identity

alt Missing or invalid JWT
    API --> Web: 401 UNAUTHORIZED
    Web --> Customer: Redirect to login
else Authenticated
    API -> DB: Load current customer's profile and preferences
    DB --> API: Profile data
    API --> Web: 200 Profile
    Web --> Customer: Display profile

    Customer -> Web: Edit profile and preferences
    Web -> API: PUT /api/customers/me\nAuthorization + updated fields
    API -> API: Validate fields and ownership

    alt Invalid fields
        API --> Web: 400 VALIDATION_ERROR
        Web --> Customer: Show field errors
    else Valid update
        API -> DB: Save profile and preference changes
        DB --> API: Updated profile
        API --> Web: 200 Updated profile
        Web --> Customer: Show saved changes
    end
end

@enduml

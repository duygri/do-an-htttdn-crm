@startuml
title Use case - Xem thông tin khách hàng

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "ADMIN" as Admin

rectangle "Hệ thống CRM" {
  usecase "Xem thông tin\nkhách hàng" as ViewCustomer
  usecase "Chọn khách hàng" as SelectCustomer
  usecase "Hiển thị thông tin\nkhách hàng" as DisplayCustomer
  usecase "Thông báo không tìm thấy\nthông tin khách hàng" as NotFound
}

Admin --> ViewCustomer
ViewCustomer .> SelectCustomer : <<include>>
ViewCustomer .> DisplayCustomer : <<include>>
NotFound .> ViewCustomer : <<extend>>
@enduml

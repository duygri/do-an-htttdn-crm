@startuml
title Use case - Quản lý và duyệt đơn hàng bán

left to right direction
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}
actor "ADMIN" as Admin

rectangle "Hệ thống CRM" {
  usecase "Quản lý và duyệt\nđơn hàng bán" as ManageOrders
  usecase "Xem danh sách đơn hàng\nchờ duyệt" as ViewPendingOrders
  usecase "Duyệt đơn hàng" as ApproveOrder
  usecase "Hủy đơn hàng" as CancelOrder
  usecase "Cập nhật trạng thái\nđơn hàng" as UpdateOrderStatus
  usecase "Hoàn lại tồn kho" as RestoreInventory
}

Admin --> ManageOrders
ManageOrders .> ViewPendingOrders : <<include>>
ApproveOrder .> ManageOrders : <<extend>>
CancelOrder .> ManageOrders : <<extend>>
ApproveOrder .> UpdateOrderStatus : <<include>>
CancelOrder .> UpdateOrderStatus : <<include>>
CancelOrder .> RestoreInventory : <<include>>
@enduml

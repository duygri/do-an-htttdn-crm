@startuml
title Use case - Báo cáo khách hàng

left to right direction
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}
actor "ADMIN" as Admin

rectangle "Hệ thống CRM" {
  usecase "Lập báo cáo\nkhách hàng" as CustomerReport
  usecase "Chọn tiêu chí báo cáo\n(nhân khẩu học, độ tuổi, sở thích)" as SelectCriteria
  usecase "Truy vấn dữ liệu\nkhách hàng" as QueryCustomerData
  usecase "Phân loại nhóm\nkhách hàng" as ClassifyCustomers
  usecase "Hiển thị bảng/biểu đồ\nphân tích" as DisplayReport
}

Admin --> CustomerReport
CustomerReport .> SelectCriteria : <<include>>
CustomerReport .> QueryCustomerData : <<include>>
CustomerReport .> ClassifyCustomers : <<include>>
CustomerReport .> DisplayReport : <<include>>
@enduml

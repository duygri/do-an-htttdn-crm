@startuml
title Use case - Xóa khách hàng

left to right direction
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}
actor "ADMIN" as Admin

rectangle "Hệ thống CRM" {
  usecase "Xóa khách hàng" as DeleteCustomer
  usecase "Chọn và xác nhận\nkhách hàng cần xóa" as SelectCustomer
  usecase "Kiểm tra ràng buộc\ndữ liệu" as CheckConstraints
  usecase "Xóa dữ liệu\nkhách hàng" as RemoveCustomer
  usecase "Thông báo xóa\nthành công" as DeleteSuccess
  usecase "Thông báo không thể xóa" as DeleteFailure
}

Admin --> DeleteCustomer
DeleteCustomer .> SelectCustomer : <<include>>
DeleteCustomer .> CheckConstraints : <<include>>
DeleteCustomer .> RemoveCustomer : <<include>>
DeleteSuccess .> DeleteCustomer : <<extend>>
DeleteFailure .> DeleteCustomer : <<extend>>
@enduml

@startuml
title Use case - Tiếp nhận và xử lý phản hồi của khách hàng

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "ADMIN" as Admin

rectangle "Hệ thống CRM" {
  usecase "Quản lý phản hồi\nkhách hàng" as ManageFeedback
  usecase "Xem danh sách phản hồi\nchờ duyệt" as ViewFeedback
  usecase "Duyệt phản hồi" as ApproveFeedback
  usecase "Từ chối phản hồi" as RejectFeedback
  usecase "Gửi thông báo kết quả\ncho khách hàng" as NotifyCustomer
}

Admin --> ManageFeedback
ManageFeedback .> ViewFeedback : <<include>>
ApproveFeedback .> ManageFeedback : <<extend>>
RejectFeedback .> ManageFeedback : <<extend>>
ApproveFeedback .> NotifyCustomer : <<include>>
RejectFeedback .> NotifyCustomer : <<include>>
@enduml

Customer -|> Guest

package "Tài khoản" {
  usecase "UC-01\nĐăng ký tài khoản" as C01
  usecase "UC-02\nĐăng nhập Customer" as C02
  usecase "UC-03\nCập nhật hồ sơ" as C03
  usecase "UC-09\nĐặt lại mật khẩu (khi được bật)" as C09
  usecase "UC-10\nĐổi mật khẩu" as C10
  usecase "UC-11\nQuản lý sổ địa chỉ" as C11
  usecase "UC-13\nXem thông báo" as C13
}
package "Sản phẩm" {
  usecase "UC-06\nTìm kiếm và xem sản phẩm" as C06
  usecase "UC-04\nGửi đánh giá sản phẩm" as C04
  usecase "UC-12\nQuản lý wishlist" as C12
}
